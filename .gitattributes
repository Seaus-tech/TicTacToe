# Track only installer packages and distribution archives via Git LFS
*.dmg filter=lfs diff=lfs merge=lfs -text
*.pkg filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Explicitly ensure all code and project configs remain standard text
*.swift text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xcproj text eol=lf
*.xcworkspace text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
