# Force Xcode project JSON layouts to merge as standard text code
*.xcproj text eol=lf
*.xcworkspace text eol=lf
*.sharedschemes text eol=lf
*.xcstrings text eol=lf

# Setup global text normalization
* text=auto

# Guard binary deployment targets (Keep these as pure data)
*.dmg binary
*.pkg binary
*.app binary
*.zip binary
