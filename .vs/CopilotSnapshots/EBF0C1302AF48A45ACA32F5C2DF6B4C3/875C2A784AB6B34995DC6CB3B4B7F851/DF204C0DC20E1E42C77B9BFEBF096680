<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:TicTacToe_Avalonia.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="760"
			 x:Class="TicTacToe_Avalonia.Views.MainView"
			 x:DataType="vm:MainViewModel"
			 Background="#F5F5F7">

  <Design.DataContext>
	<vm:MainViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="232,*">
	<Border Grid.Column="0" Background="#F0F1F3" BorderBrush="#E1E3E6" BorderThickness="0,0,1,0">
	  <Grid RowDefinitions="Auto,Auto,*" Margin="20,24">
		<TextBlock Grid.Row="0" Text="Tic Tac Toe" FontSize="23" FontWeight="SemiBold" Margin="4,0,0,20" />
		<StackPanel Grid.Row="1" Spacing="4">
		  <Button Content="Play" Command="{Binding ShowPlayCommand}" HorizontalContentAlignment="Left" Padding="12,9" />
		  <Button Content="Game Options" Command="{Binding ShowOptionsCommand}" HorizontalContentAlignment="Left" Padding="12,9" />
		  <Button Content="Score" Command="{Binding ShowScoreCommand}" HorizontalContentAlignment="Left" Padding="12,9" />
		</StackPanel>

		<StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="12" Margin="4,0,4,8">
		  <TextBlock Text="This Session" FontSize="14" FontWeight="SemiBold" />
		  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
			<TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#3973E6" />
			<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScoreX}" Foreground="#3973E6" />
			<TextBlock Grid.Row="1" Grid.Column="0" Text="O" Foreground="#D47A16" />
			<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScoreO}" Foreground="#D47A16" />
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Draws" />
			<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DrawCount}" />
		  </Grid>
		</StackPanel>
	  </Grid>
	</Border>

	<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="32,24">
	  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
		<TextBlock Grid.Column="0" Text="{Binding SectionTitle}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
		<Button Grid.Column="1" Content="New Game" Command="{Binding NewGameCommand}" IsVisible="{Binding IsPlaySection}" Padding="16,9" />
	  </Grid>

	  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
		<Grid>
		  <StackPanel IsVisible="{Binding IsPlaySection}" HorizontalAlignment="Center" MaxWidth="640" Spacing="20" Margin="0,12,0,24">
			<Border Background="White" BorderBrush="#E1E3E6" BorderThickness="1" CornerRadius="12" Padding="12,10" HorizontalAlignment="Center" MaxWidth="380">
			  <Grid ColumnDefinitions="*,Auto,*,Auto,*" MinWidth="320">
				<StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
				  <TextBlock Text="X" Foreground="#3973E6" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
				  <TextBlock Text="{Binding ScoreX}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
				</StackPanel>
				<Border Grid.Column="1" Width="1" Height="34" Background="#E1E3E6" VerticalAlignment="Center" />
				<StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
				  <TextBlock Text="Draws" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
				  <TextBlock Text="{Binding DrawCount}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
				</StackPanel>
				<Border Grid.Column="3" Width="1" Height="34" Background="#E1E3E6" VerticalAlignment="Center" />
				<StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
				  <TextBlock Text="O" Foreground="#D47A16" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
				  <TextBlock Text="{Binding ScoreO}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
				</StackPanel>
			  </Grid>
			</Border>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
			  <Ellipse Width="9" Height="9" Fill="#3973E6" VerticalAlignment="Center" />
			  <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
			</StackPanel>

			<Viewbox HorizontalAlignment="Center" Stretch="Uniform" MaxWidth="520" MaxHeight="520">
			  <Border Width="520" Height="520" Background="#E1E3E6" CornerRadius="12" Padding="2">
				<ItemsControl ItemsSource="{Binding GridCells}" Width="516" Height="516">
				  <ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
					  <UniformGrid Rows="3" Columns="3" />
					</ItemsPanelTemplate>
				  </ItemsControl.ItemsPanel>
				  <ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:GridCell">
					  <Button Command="{Binding $parent[UserControl].DataContext.CellClickCommand}"
							  CommandParameter="{Binding Index}"
							  IsEnabled="{Binding IsEnabled}"
							  Margin="2"
							  Padding="0"
							  Background="#FFFFFF"
							  BorderBrush="{Binding CellBorderColor}"
							  BorderThickness="{Binding IsWinningCell, Converter={x:Static BooleanConverters.Instance}}"
							  CornerRadius="8"
							  HorizontalAlignment="Stretch"
							  VerticalAlignment="Stretch">
						<TextBlock Text="{Binding Value}"
								   FontSize="58"
								   FontWeight="Medium"
								   Foreground="{Binding CellColor}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center" />
					  </Button>
					</DataTemplate>
				  </ItemsControl.ItemTemplate>
				</ItemsControl>
			  </Border>
			</Viewbox>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
			  <Button Content="Undo Turn" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Padding="16,9" />
			  <Button Content="New Game" Command="{Binding NewGameCommand}" Padding="16,9" />
			</StackPanel>
		  </StackPanel>

		  <StackPanel IsVisible="{Binding IsOptionsSection}" Spacing="20" MaxWidth="620" HorizontalAlignment="Stretch" Margin="0,8">
			<Border Background="White" BorderBrush="#E1E3E6" BorderThickness="1" CornerRadius="12" Padding="20">
			  <StackPanel Spacing="16">
				<TextBlock Text="Players" FontSize="18" FontWeight="SemiBold" />
				<StackPanel Orientation="Horizontal" Spacing="12">
				  <TextBlock Text="Game" Width="130" VerticalAlignment="Center" />
				  <ComboBox SelectedIndex="{Binding ModeIndex}" MinWidth="190">
					<ComboBoxItem Content="Play Bot" />
					<ComboBoxItem Content="Two Players" />
				  </ComboBox>
				</StackPanel>
				<TextBlock Text="Online matchmaking is available in the Apple app." Foreground="#62666D" TextWrapping="Wrap" />
			  </StackPanel>
			</Border>

			<Border Background="White" BorderBrush="#E1E3E6" BorderThickness="1" CornerRadius="12" Padding="20" IsVisible="{Binding IsBotMode}">
			  <StackPanel Spacing="16">
				<TextBlock Text="Bot" FontSize="18" FontWeight="SemiBold" />
				<StackPanel Orientation="Horizontal" Spacing="12">
				  <TextBlock Text="Difficulty" Width="130" VerticalAlignment="Center" />
				  <ComboBox SelectedIndex="{Binding DifficultyIndex}" MinWidth="190">
					<ComboBoxItem Content="Rookie" />
					<ComboBoxItem Content="Cadet" />
					<ComboBoxItem Content="Tactician" />
					<ComboBoxItem Content="Veteran" />
					<ComboBoxItem Content="Nemesis" />
				  </ComboBox>
				</StackPanel>
			  </StackPanel>
			</Border>
		  </StackPanel>

		  <StackPanel IsVisible="{Binding IsScoreSection}" Spacing="20" MaxWidth="620" HorizontalAlignment="Stretch" Margin="0,8">
			<Border Background="White" BorderBrush="#E1E3E6" BorderThickness="1" CornerRadius="12" Padding="20">
			  <StackPanel Spacing="12">
				<TextBlock Text="Current Score" FontSize="18" FontWeight="SemiBold" />
				<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
				  <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#3973E6" />
				  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScoreX}" Foreground="#3973E6" />
				  <TextBlock Grid.Row="1" Grid.Column="0" Text="O" Foreground="#D47A16" />
				  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScoreO}" Foreground="#D47A16" />
				  <TextBlock Grid.Row="2" Grid.Column="0" Text="Draws" />
				  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DrawCount}" />
				</Grid>
			  </StackPanel>
			</Border>

			<Border Background="White" BorderBrush="#E1E3E6" BorderThickness="1" CornerRadius="12" Padding="20">
			  <StackPanel Spacing="12">
				<TextBlock Text="Progress" FontSize="18" FontWeight="SemiBold" />
				<Grid ColumnDefinitions="*,Auto">
				  <TextBlock Grid.Column="0" Text="Win Streak" />
				  <TextBlock Grid.Column="1" Text="{Binding WinStreak}" />
				</Grid>
			  </StackPanel>
			</Border>

			<Button Content="Reset Score" Command="{Binding ResetScoresCommand}" HorizontalAlignment="Left" Padding="16,9" />
		  </StackPanel>
		</Grid>
	  </ScrollViewer>
	</Grid>
  </Grid>
</UserControl>
