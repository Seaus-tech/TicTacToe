<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TicTacToe_Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:TicTacToe_Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="760"
        x:Class="TicTacToe_Avalonia.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Tic Tac Toe"
        MinWidth="360" MinHeight="480">
        <views:MainView />
</Window>
